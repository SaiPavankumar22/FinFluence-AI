MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=market_intel

NEBIUS_API_KEY=your_api_key
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=google/gemma-3-27b-it

TRANSCRIPTION_PROVIDER=sarvam
SARVAM_API_SUBSCRIPTION_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v3
SARVAM_LANGUAGE_CODE=unknown
SARVAM_MODE=transcribe
SARVAM_SAMPLE_RATE=16000
SARVAM_CHUNK_SECONDS=25
SARVAM_PARALLEL_CHUNKS=4
SARVAM_MAX_RETRIES=2

WHISPER_MODEL_SIZE=medium
# Force CPU unless you have full CUDA + cuBLAS installed
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_NUM_WORKERS=2
REEL_AUDIO_MAX_SECONDS=0

CHECK_INTERVAL_MINUTES=15
HISTORICAL_REELS_LIMIT=15

DOWNLOAD_DIR=./downloads

# Optional: logging into Instagram reduces (but does not remove) rate-limiting.
# Using a real personal account for scraping risks that account being flagged/banned.
# Leave blank to scrape anonymously (lower limits, public profiles only).
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
